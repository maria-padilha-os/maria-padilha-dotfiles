# Maria Padilha btop fallback theme.
#
# padilha-dots copies this file only when
# ~/.config/btop/themes/caelestia.theme does not exist. padilha-theme owns the
# installed copy after the first apply and renders it from
# maria-padilha-de/share/templates/btop.theme.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=#f8fbf1

# Main text color
theme[main_fg]=#191d17

# Title color for boxes
theme[title]=#191d17

# Highlight color for keyboard shortcuts
theme[hi_fg]=#406836

# Background color of selected item in processes box
theme[selected_bg]=#c0efb0

# Foreground color of selected item in processes box
theme[selected_fg]=#002200

# Color of inactive/disabled text
theme[inactive_fg]=#5a6056

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]=#386568

# Background color of the percentage meters
theme[meter_bg]=#e1e4da

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]=#386568

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]=#005e65
theme[mem_box]=#17810b
theme[net_box]=#616b00
theme[proc_box]=#00664e

# Box divider line and small boxes line color
theme[div_line]=#5a6056

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]=#17810b
theme[temp_mid]=#67891e
theme[temp_end]=#515900

# CPU graph colors (Teal -> Sapphire -> Lavender)
theme[cpu_start]=#307547
theme[cpu_mid]=#308151
theme[cpu_end]=#00816c

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]=#005e65
theme[free_mid]=#00816c
theme[free_end]=#00664e

# Mem/Disk cached meter (Sapphire -> Blue -> Lavender)
theme[cached_start]=#308151
theme[cached_mid]=#00664e
theme[cached_end]=#00816c

# Mem/Disk available meter (Peach -> Maroon -> Red)
theme[available_start]=#697e00
theme[available_mid]=#616b00
theme[available_end]=#515900

# Mem/Disk used meter (Green -> Teal -> Sky)
theme[used_start]=#17810b
theme[used_mid]=#307547
theme[used_end]=#008b59

# Download graph colors (Peach -> Maroon -> Red)
theme[download_start]=#697e00
theme[download_mid]=#616b00
theme[download_end]=#515900

# Upload graph colors (Green -> Teal -> Sky)
theme[upload_start]=#17810b
theme[upload_mid]=#307547
theme[upload_end]=#008b59

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Lavender -> Mauve)
theme[process_start]=#308151
theme[process_mid]=#00816c
theme[process_end]=#005e65
