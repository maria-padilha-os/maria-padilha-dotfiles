# Maria Padilha micro colourscheme (Dark).
# Static fallback rendered from hypr/scheme/current.lua; padilha-theme owns the
# installed copy in ~/.config/micro/colorschemes/padilha.micro after the first
# apply. Template: maria-padilha-de/share/templates/micro.micro

color-link default "#e5e1e9,#131318"

# Syntax: the same ayu-shaped grammar as nvim's colours/caelestia.lua, but
# every hue is drawn from the current scheme instead of a fixed table.
color-link comment "#c8c5d0"
color-link comment.bright "#928f9a"
color-link constant "#cab5ed"
color-link constant.bool "#cab5ed"
color-link constant.number "#cab5ed"
color-link constant.string "#c8e3ff"
color-link constant.string.url "underline #b1b7ff"
color-link constant.specialChar "#c0b8ff"
color-link identifier "#e5e1e9"
color-link identifier.class "#eab9d2"
color-link identifier.macro "#c2a5fd"
color-link identifier.var "#e5e1e9"
color-link statement "#c3c0ff"
color-link symbol "#e5e1e9"
color-link symbol.operator "#c2a5fd"
color-link symbol.brackets "#928f9a"
color-link preproc "#c2a5fd"
color-link type "#b1b7ff"
color-link special "#d4dfff"
color-link underlined "underline #e5e1e9"

# Chrome: surfaces, tabs and the status line.
color-link error "bold #690005,#ffb4ab"
color-link todo "bold #eab9d2"
color-link selection "#e5e1e9,#424178"
color-link statusline "#e5e1e9,#2a292f"
color-link statusline.inactive "#c8c5d0,#201f25"
color-link statusline.suggestions "#e5e1e9,#35343a"
color-link tabbar "#c8c5d0,#201f25"
color-link tabbar.active "bold #e5e1e9,#2a292f"
color-link message "#e5e1e9,#2a292f"
color-link error-message "bold #690005,#ffb4ab"
color-link divider "#928f9a,#131318"
color-link scrollbar "#928f9a,#131318"

# Gutter, cursor and search.
color-link indent-char "#47464f"
color-link line-number "#928f9a"
color-link current-line-number "bold #c3c0ff"
color-link gutter-info "#b1b7ff"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#eab9d2"
color-link cursor-line ",#201f25"
color-link color-column ",#35343a"
color-link match-brace "bold #2b2a60,#c3c0ff"
color-link hlsearch "#2b2a60,#c3c0ff"

# Diffs and whitespace warnings.
color-link diff-added "#c8e3ff"
color-link diff-modified "#eab9d2"
color-link diff-deleted "#c2a5fd"
color-link tab-error "#ffdad6,#93000a"
color-link trailingws ",#93000a"
color-link ignore "default"
