# Maria Padilha micro colourscheme (Light).
# Generated by padilha-theme from the Material You palette; do not edit.
# Template: maria-padilha-de/share/templates/micro.micro

color-link default "#231918,#fff8f6"

# Syntax: the same ayu-shaped grammar as nvim's colours/caelestia.lua, but
# every hue is drawn from the current scheme instead of a fixed table.
color-link comment "#534340"
color-link comment.bright "#857370"
color-link constant "#d63f1c"
color-link constant.bool "#d63f1c"
color-link constant.number "#d63f1c"
color-link constant.string "#b05500"
color-link constant.string.url "underline #b359a2"
color-link constant.specialChar "#aa0538"
color-link identifier "#231918"
color-link identifier.class "#c75f3b"
color-link identifier.macro "#d35255"
color-link identifier.var "#231918"
color-link statement "#904b3e"
color-link symbol "#231918"
color-link symbol.operator "#ad0003"
color-link symbol.brackets "#857370"
color-link preproc "#d35255"
color-link type "#aa1f50"
color-link special "#756908"
color-link underlined "underline #231918"

# Chrome: surfaces, tabs and the status line.
color-link error "bold #ffffff,#ba1a1a"
color-link todo "bold #c75f3b"
color-link selection "#231918,#ffdad4"
color-link statusline "#231918,#f7e4e1"
color-link statusline.inactive "#534340,#fceae6"
color-link statusline.suggestions "#231918,#f1dfdb"
color-link tabbar "#534340,#fceae6"
color-link tabbar.active "bold #231918,#f7e4e1"
color-link message "#231918,#f7e4e1"
color-link error-message "bold #ffffff,#ba1a1a"
color-link divider "#d8c2be,#fff8f6"
color-link scrollbar "#857370,#fff8f6"

# Gutter, cursor and search.
color-link indent-char "#d8c2be"
color-link line-number "#857370"
color-link current-line-number "bold #904b3e"
color-link gutter-info "#aa1f50"
color-link gutter-error "#ba1a1a"
color-link gutter-warning "#c75f3b"
color-link cursor-line ",#fceae6"
color-link color-column ",#f1dfdb"
color-link match-brace "bold #ffffff,#904b3e"
color-link hlsearch "#ffffff,#904b3e"

# Diffs and whitespace warnings.
color-link diff-added "#b05500"
color-link diff-modified "#c75f3b"
color-link diff-deleted "#ad0003"
color-link tab-error "#410002,#ffdad6"
color-link trailingws ",#ffdad6"
color-link ignore "default"
