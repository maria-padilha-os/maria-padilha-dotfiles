# Maria Padilha micro colourscheme (Light).
# Static fallback rendered from hypr/scheme/current.lua; padilha-theme owns the
# installed copy in ~/.config/micro/colorschemes/padilha.micro after the first
# apply. Template: maria-padilha-de/share/templates/micro.micro

color-link default "#191d17,#f8fbf1"

# Syntax: the same ayu-shaped grammar as nvim's colours/caelestia.lua, but
# every hue is drawn from the current scheme instead of a fixed table.
color-link comment "#43483f"
color-link comment.bright "#5a6056"
color-link constant "#616b00"
color-link constant.bool "#616b00"
color-link constant.number "#616b00"
color-link constant.string "#17810b"
color-link constant.string.url "underline #00664e"
color-link constant.specialChar "#005e65"
color-link identifier "#191d17"
color-link identifier.class "#386568"
color-link identifier.macro "#515900"
color-link identifier.var "#191d17"
color-link statement "#406836"
color-link symbol "#191d17"
color-link symbol.operator "#515900"
color-link symbol.brackets "#5a6056"
color-link preproc "#515900"
color-link type "#00664e"
color-link special "#307547"
color-link underlined "underline #191d17"

# Chrome: surfaces, tabs and the status line.
color-link error "bold #ffffff,#ba1a1a"
color-link todo "bold #386568"
color-link selection "#191d17,#c0efb0"
color-link statusline "#191d17,#e6e9e0"
color-link statusline.inactive "#43483f,#ecefe5"
color-link statusline.suggestions "#191d17,#e1e4da"
color-link tabbar "#43483f,#ecefe5"
color-link tabbar.active "bold #191d17,#e6e9e0"
color-link message "#191d17,#e6e9e0"
color-link error-message "bold #ffffff,#ba1a1a"
color-link divider "#5a6056,#f8fbf1"
color-link scrollbar "#5a6056,#f8fbf1"

# Gutter, cursor and search.
color-link indent-char "#c3c8bc"
color-link line-number "#5a6056"
color-link current-line-number "bold #406836"
color-link gutter-info "#00664e"
color-link gutter-error "#ba1a1a"
color-link gutter-warning "#386568"
color-link cursor-line ",#ecefe5"
color-link color-column ",#e1e4da"
color-link match-brace "bold #ffffff,#406836"
color-link hlsearch "#ffffff,#406836"

# Diffs and whitespace warnings.
color-link diff-added "#17810b"
color-link diff-modified "#386568"
color-link diff-deleted "#515900"
color-link tab-error "#410002,#ffdad6"
color-link trailingws ",#ffdad6"
color-link ignore "default"
