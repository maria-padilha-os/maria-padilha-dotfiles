#!/bin/sh
# Link the Padilha-owned configs from this checkout into XDG_CONFIG_HOME.
#
# On a fresh machine, move any existing real directories aside first; this
# script refuses to overwrite them.
#
#   padilha-dots             link hypr, nvim, wezterm and mc
#   padilha-dots hypr        link only the Hyprland config
#   padilha-dots mc          link only the static Midnight Commander files
#
# MC keeps its panels, hotlist and history in ~/.config/mc and
# ~/.local/share/mc. Only ini, mc.keymap and mc.ext.ini are linked; the
# caelestia skin itself is generated by padilha-theme in lilith-de.
set -eu

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
config="${XDG_CONFIG_HOME:-$HOME/.config}"

names=${*:-"hypr nvim wezterm mc"}

mkdir -p "$config"

for name in $names; do
    if [ "$name" = mc ]; then
        mc_src="$root/mc"
        mc_dst="$config/mc"
        if [ ! -d "$mc_src" ]; then
            echo "padilha-dots: missing $mc_src" >&2
            exit 1
        fi
        mkdir -p "$mc_dst"
        for file in ini mc.keymap mc.ext.ini; do
            src="$mc_src/$file"
            dst="$mc_dst/$file"
            if [ ! -f "$src" ]; then
                echo "padilha-dots: missing $src" >&2
                exit 1
            fi
            if [ -e "$dst" ] && [ ! -L "$dst" ]; then
                echo "padilha-dots: refusing to replace real path $dst" >&2
                exit 1
            fi
            ln -sfn "$src" "$dst"
            printf '%s -> %s\n' "$dst" "$src"
        done
        continue
    fi

    src="$root/$name"
    dst="$config/$name"

    if [ ! -d "$src" ]; then
        echo "padilha-dots: missing $src" >&2
        exit 1
    fi

    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        echo "padilha-dots: refusing to replace real path $dst" >&2
        exit 1
    fi

    ln -sfn "$src" "$dst"
    printf '%s -> %s\n' "$dst" "$src"
done
