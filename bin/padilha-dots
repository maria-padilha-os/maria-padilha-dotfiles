#!/bin/sh
# Link the Maria Padilha-owned configs from this checkout into XDG_CONFIG_HOME.
#
# On a fresh machine, move any existing real directories aside first; this
# script refuses to overwrite them.
#
#   padilha-dots             link hypr, nvim, wezterm, mc and Firefox
#   padilha-dots hypr        link only the Hyprland config
#   padilha-dots mc          install only the Midnight Commander files
#   padilha-dots firefox     install into the detected Firefox profile
#
# MC keeps its panels, hotlist and history in ~/.config/mc and
# ~/.local/share/mc. mc.keymap and mc.ext.ini are linked; ini is copied once
# because MC rewrites its setup (including [Panelize]) on exit. The caelestia
# skin itself is generated by padilha-theme in maria-padilha-de.
#
# Firefox has no profile until it has been launched once. In that case the
# Firefox step prints a note and leaves the rest of the command alone; rerun
# `padilha-dots firefox` after the first launch. The palette file
# (chrome/lilith.css) is generated by padilha-theme, not by this script.
set -eu

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
root=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)
config="${XDG_CONFIG_HOME:-$HOME/.config}"

names=${*:-"hypr nvim wezterm mc firefox micro"}

mkdir -p "$config"

# --- Firefox -------------------------------------------------------------
# profiles.ini is the only supported way to find the default profile. Emit
# candidates with a priority (1 = Default=1, 2 = Install Default, 3 = first
# profile) and let the caller take the first directory that exists.
firefox_from_ini() {
    ff_ini_root=$1
    ff_ini=$ff_ini_root/profiles.ini
    [ -f "$ff_ini" ] || return 0
    ff_candidates=$(awk '
        function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
        /^[ \t]*\[/ {
            if (section ~ /^\[Profile/ && profile_path != "") {
                print (profile_default ? "2" : "3") "|" profile_path
            }
            section = trim($0)
            profile_path = ""
            profile_default = 0
            next
        }
        {
            eq = index($0, "=")
            if (eq == 0) next
            key = tolower(trim(substr($0, 1, eq - 1)))
            val = trim(substr($0, eq + 1))
            if (section ~ /^\[Profile/) {
                if (key == "path") profile_path = val
                else if (key == "default") profile_default = (val != "" && val != "0")
            } else if (section ~ /^\[Install/ && key == "default") {
                print "1|" val
            }
        }
        END {
            if (section ~ /^\[Profile/ && profile_path != "") {
                print (profile_default ? "2" : "3") "|" profile_path
            }
        }
    ' "$ff_ini" | sort -n -t'|' -k1,1)
    while IFS='|' read -r _ff_priority ff_path; do
        [ -n "$ff_path" ] || continue
        case $ff_path in
            /*) ff_dir=$ff_path ;;
            *) ff_dir=$ff_ini_root/$ff_path ;;
        esac
        if [ -d "$ff_dir" ]; then
            printf '%s\n' "$ff_dir"
            return 0
        fi
    done <<EOF
$ff_candidates
EOF
    return 0
}

find_firefox_profile() {
    # Keep the new name primary and the pre-rename name accepted, exactly like
    # the theme engine's PADILHA_FIREFOX_PROFILE_DIR / LILITH_... lookup.
    ff_override=${PADILHA_FIREFOX_PROFILE_DIR:-${LILITH_FIREFOX_PROFILE_DIR:-}}
    if [ -n "$ff_override" ]; then
        if [ -d "$ff_override" ]; then
            printf '%s\n' "$ff_override"
        fi
        return 0
    fi
    [ -n "${HOME:-}" ] || return 0
    # Newer Firefox builds (and some distro configs) keep profiles under
    # XDG_CONFIG_HOME instead of ~/.mozilla.
    ff_found=$(firefox_from_ini "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    ff_found=$(firefox_from_ini "$HOME/.mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    ff_found=$(firefox_from_ini "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    ff_found=$(firefox_from_ini "$HOME/snap/firefox/common/.mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    return 0
}

firefox_backup() {
    ff_stamp=$(date +%Y%m%d-%H%M%S)
    ff_backup=$1.pre-padilha-$ff_stamp
    ff_i=1
    while [ -e "$ff_backup" ] || [ -L "$ff_backup" ]; do
        ff_backup=$1.pre-padilha-$ff_stamp-$ff_i
        ff_i=$((ff_i + 1))
    done
    printf '%s\n' "$ff_backup"
}

install_firefox() {
    ff_src=$root/firefox
    if [ ! -d "$ff_src" ]; then
        echo "padilha-dots: missing $ff_src" >&2
        exit 1
    fi

    ff_profile=$(find_firefox_profile)
    if [ -z "$ff_profile" ]; then
        echo "padilha-dots: no Firefox profile yet; launch Firefox once, quit it, then run 'padilha-dots firefox'." >&2
        return 0
    fi

    ff_chrome=$ff_profile/chrome
    if [ -e "$ff_chrome" ] && [ ! -d "$ff_chrome" ]; then
        echo "padilha-dots: $ff_chrome exists and is not a directory" >&2
        exit 1
    fi
    mkdir -p "$ff_chrome"

    # user.js must be a real copy at the profile root.
    ff_dst=$ff_profile/user.js
    if [ -d "$ff_dst" ]; then
        echo "padilha-dots: $ff_dst is a directory" >&2
        exit 1
    fi
    if [ -e "$ff_dst" ] || [ -L "$ff_dst" ]; then
        if [ -L "$ff_dst" ] || ! cmp -s "$ff_src/user.js" "$ff_dst"; then
            ff_backup=$(firefox_backup "$ff_dst")
            echo "padilha-dots: backing up $ff_dst -> $ff_backup" >&2
            mv "$ff_dst" "$ff_backup"
        fi
    fi
    cp "$ff_src/user.js" "$ff_dst"
    printf '%s -> %s\n' "$ff_dst" "$ff_src/user.js"

    # The stylesheets are linked, so edits in the checkout apply on the next
    # Firefox start. A real file already there is backed up, never deleted.
    for ff_name in userChrome.css userContent.css; do
        ff_src_file=$ff_src/chrome/$ff_name
        ff_dst_file=$ff_chrome/$ff_name
        if [ ! -f "$ff_src_file" ]; then
            echo "padilha-dots: missing $ff_src_file" >&2
            exit 1
        fi
        if [ -e "$ff_dst_file" ] || [ -L "$ff_dst_file" ]; then
            ff_existing=$(readlink -f -- "$ff_dst_file" 2>/dev/null || true)
            ff_wanted=$(readlink -f -- "$ff_src_file" 2>/dev/null || true)
            if [ -n "$ff_existing" ] && [ "$ff_existing" = "$ff_wanted" ]; then
                :
            else
                ff_backup=$(firefox_backup "$ff_dst_file")
                echo "padilha-dots: backing up $ff_dst_file -> $ff_backup" >&2
                mv "$ff_dst_file" "$ff_backup"
            fi
        fi
        ln -sfn "$ff_src_file" "$ff_dst_file"
        printf '%s -> %s\n' "$ff_dst_file" "$ff_src_file"
    done

    if [ ! -f "$ff_chrome/lilith.css" ]; then
        echo "padilha-dots: note: $ff_chrome/lilith.css is missing; run 'padilha-theme apply --wallpaper ...' to generate the palette." >&2
    fi
}
# -------------------------------------------------------------------------

for name in $names; do
    if [ "$name" = mc ]; then
        mc_src="$root/mc"
        mc_dst="$config/mc"
        if [ ! -d "$mc_src" ]; then
            echo "padilha-dots: missing $mc_src" >&2
            exit 1
        fi
        mkdir -p "$mc_dst"
        for file in ini mc.keymap mc.ext.ini; do
            src="$mc_src/$file"
            dst="$mc_dst/$file"
            if [ ! -f "$src" ]; then
                echo "padilha-dots: missing $src" >&2
                exit 1
            fi
            if [ "$file" = ini ]; then
                # MC writes its setup (including the [Panelize] order) back to
                # ini on exit. Keep it a real file so the repository does not
                # become dirty every time MC is used; only seed it once.
                if [ -L "$dst" ]; then
                    rm -f "$dst"
                elif [ -e "$dst" ]; then
                    printf '%s (keeping existing mutable MC ini)\n' "$dst"
                    continue
                fi
                cp -f "$src" "$dst"
                printf '%s (copy)\n' "$dst"
                continue
            fi
            if [ -e "$dst" ] && [ ! -L "$dst" ]; then
                echo "padilha-dots: refusing to replace real path $dst" >&2
                exit 1
            fi
            ln -sfn "$src" "$dst"
            printf '%s -> %s\n' "$dst" "$src"
        done
        continue
    fi

    if [ "$name" = firefox ]; then
        install_firefox
        continue
    fi

    if [ "$name" = micro ]; then
        if [ ! -x "$root/micro/install.sh" ]; then
            echo "padilha-dots: missing $root/micro/install.sh" >&2
            exit 1
        fi
        "$root/micro/install.sh"
        continue
    fi

    src="$root/$name"
    dst="$config/$name"

    if [ ! -d "$src" ]; then
        echo "padilha-dots: missing $src" >&2
        exit 1
    fi

    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        echo "padilha-dots: refusing to replace real path $dst" >&2
        exit 1
    fi

    ln -sfn "$src" "$dst"
    printf '%s -> %s\n' "$dst" "$src"
done
