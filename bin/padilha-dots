#!/bin/sh
# Link the Maria Padilha-owned configs from this checkout into XDG_CONFIG_HOME.
#
# On a fresh machine, move any existing real directories aside first; this
# script refuses to overwrite them.
#
#   padilha-dots             link hypr, nvim, wezterm, mc, btop, Thunar, GTK, Flatpak, Thunderbird and Firefox
#   padilha-dots hypr        link only the Hyprland config
#   padilha-dots mc          install only the Midnight Commander files
#   padilha-dots thunar      link Thunar and the GTK settings
#   padilha-dots gtk         link only the GTK 3 and GTK 4 settings
#   padilha-dots flatpak     link the user-scoped Flatpak theme overrides
#   padilha-dots flatpak-reset remove only the linked Flatpak theme overrides
#   padilha-dots firefox     install into the detected Firefox profile
#
# The GTK step links gtk-3.0/settings.ini and gtk-4.0/settings.ini only. The
# colour sheets (gtk.css and thunar.css in both directories) are generated by
# padilha-theme in maria-padilha-de and stay local, so they are never copied or
# overwritten.
#
# The Flatpak step links flatpak/overrides/global into the *user* installation
# at ${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/overrides/global. It never
# changes the system installation or writes a root-owned path; flatpak-reset
# removes only that symlink.
#
# MC keeps its panels, hotlist and history in ~/.config/mc and
# ~/.local/share/mc. mc.keymap and mc.ext.ini are linked; ini is copied once
# because MC rewrites its setup (including [Panelize]) on exit. The caelestia
# skin itself is generated by padilha-theme in maria-padilha-de.
#
# Firefox has no profile until it has been launched once. In that case the
# Firefox step prints a note and leaves the rest of the command alone; rerun
# `padilha-dots firefox` after the first launch. The palette file
# (chrome/lilith.css) is generated by padilha-theme, not by this script.
set -eu

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
root=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)
config="${XDG_CONFIG_HOME:-$HOME/.config}"

names=${*:-"hypr nvim wezterm lazygit mc thunderbird firefox micro btop thunar gtk flatpak"}

mkdir -p "$config"

# --- Firefox -------------------------------------------------------------
# profiles.ini is the only supported way to find the default profile. Emit
# candidates with a priority (1 = Default=1, 2 = Install Default, 3 = first
# profile) and let the caller take the first directory that exists.
firefox_from_ini() {
    ff_ini_root=$1
    ff_ini=$ff_ini_root/profiles.ini
    [ -f "$ff_ini" ] || return 0
    ff_candidates=$(awk '
        function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
        /^[ \t]*\[/ {
            if (section ~ /^\[Profile/ && profile_path != "") {
                print (profile_default ? "2" : "3") "|" profile_path
            }
            section = trim($0)
            profile_path = ""
            profile_default = 0
            next
        }
        {
            eq = index($0, "=")
            if (eq == 0) next
            key = tolower(trim(substr($0, 1, eq - 1)))
            val = trim(substr($0, eq + 1))
            if (section ~ /^\[Profile/) {
                if (key == "path") profile_path = val
                else if (key == "default") profile_default = (val != "" && val != "0")
            } else if (section ~ /^\[Install/ && key == "default") {
                print "1|" val
            }
        }
        END {
            if (section ~ /^\[Profile/ && profile_path != "") {
                print (profile_default ? "2" : "3") "|" profile_path
            }
        }
    ' "$ff_ini" | sort -n -t'|' -k1,1)
    while IFS='|' read -r _ff_priority ff_path; do
        [ -n "$ff_path" ] || continue
        case $ff_path in
            /*) ff_dir=$ff_path ;;
            *) ff_dir=$ff_ini_root/$ff_path ;;
        esac
        if [ -d "$ff_dir" ]; then
            printf '%s\n' "$ff_dir"
            return 0
        fi
    done <<EOF
$ff_candidates
EOF
    return 0
}

find_firefox_profile() {
    # Keep the new name primary and the pre-rename name accepted, exactly like
    # the theme engine's PADILHA_FIREFOX_PROFILE_DIR / LILITH_... lookup.
    ff_override=${PADILHA_FIREFOX_PROFILE_DIR:-${LILITH_FIREFOX_PROFILE_DIR:-}}
    if [ -n "$ff_override" ]; then
        if [ -d "$ff_override" ]; then
            printf '%s\n' "$ff_override"
        fi
        return 0
    fi
    [ -n "${HOME:-}" ] || return 0
    # Newer Firefox builds (and some distro configs) keep profiles under
    # XDG_CONFIG_HOME instead of ~/.mozilla.
    ff_found=$(firefox_from_ini "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    ff_found=$(firefox_from_ini "$HOME/.mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    ff_found=$(firefox_from_ini "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    ff_found=$(firefox_from_ini "$HOME/snap/firefox/common/.mozilla/firefox")
    if [ -n "$ff_found" ]; then
        printf '%s\n' "$ff_found"
        return 0
    fi
    return 0
}

firefox_backup() {
    ff_stamp=$(date +%Y%m%d-%H%M%S)
    ff_backup=$1.pre-padilha-$ff_stamp
    ff_i=1
    while [ -e "$ff_backup" ] || [ -L "$ff_backup" ]; do
        ff_backup=$1.pre-padilha-$ff_stamp-$ff_i
        ff_i=$((ff_i + 1))
    done
    printf '%s\n' "$ff_backup"
}

install_firefox() {
    ff_src=$root/firefox
    if [ ! -d "$ff_src" ]; then
        echo "padilha-dots: missing $ff_src" >&2
        exit 1
    fi

    ff_profile=$(find_firefox_profile)
    if [ -z "$ff_profile" ]; then
        echo "padilha-dots: no Firefox profile yet; launch Firefox once, quit it, then run 'padilha-dots firefox'." >&2
        return 0
    fi

    ff_chrome=$ff_profile/chrome
    if [ -e "$ff_chrome" ] && [ ! -d "$ff_chrome" ]; then
        echo "padilha-dots: $ff_chrome exists and is not a directory" >&2
        exit 1
    fi
    mkdir -p "$ff_chrome"

    # user.js must be a real copy at the profile root.
    ff_dst=$ff_profile/user.js
    if [ -d "$ff_dst" ]; then
        echo "padilha-dots: $ff_dst is a directory" >&2
        exit 1
    fi
    if [ -e "$ff_dst" ] || [ -L "$ff_dst" ]; then
        if [ -L "$ff_dst" ] || ! cmp -s "$ff_src/user.js" "$ff_dst"; then
            ff_backup=$(firefox_backup "$ff_dst")
            echo "padilha-dots: backing up $ff_dst -> $ff_backup" >&2
            mv "$ff_dst" "$ff_backup"
        fi
    fi
    cp "$ff_src/user.js" "$ff_dst"
    printf '%s -> %s\n' "$ff_dst" "$ff_src/user.js"

    # The stylesheets are linked, so edits in the checkout apply on the next
    # Firefox start. A real file already there is backed up, never deleted.
    for ff_name in userChrome.css userContent.css; do
        ff_src_file=$ff_src/chrome/$ff_name
        ff_dst_file=$ff_chrome/$ff_name
        if [ ! -f "$ff_src_file" ]; then
            echo "padilha-dots: missing $ff_src_file" >&2
            exit 1
        fi
        if [ -e "$ff_dst_file" ] || [ -L "$ff_dst_file" ]; then
            ff_existing=$(readlink -f -- "$ff_dst_file" 2>/dev/null || true)
            ff_wanted=$(readlink -f -- "$ff_src_file" 2>/dev/null || true)
            if [ -n "$ff_existing" ] && [ "$ff_existing" = "$ff_wanted" ]; then
                :
            else
                ff_backup=$(firefox_backup "$ff_dst_file")
                echo "padilha-dots: backing up $ff_dst_file -> $ff_backup" >&2
                mv "$ff_dst_file" "$ff_backup"
            fi
        fi
        ln -sfn "$ff_src_file" "$ff_dst_file"
        printf '%s -> %s\n' "$ff_dst_file" "$ff_src_file"
    done

    if [ ! -f "$ff_chrome/lilith.css" ]; then
        echo "padilha-dots: note: $ff_chrome/lilith.css is missing; run 'padilha-theme apply --wallpaper ...' to generate the palette." >&2
    fi
}
# --- Thunderbird ---------------------------------------------------------
find_thunderbird_profile() {
    tb_override=${PADILHA_THUNDERBIRD_PROFILE_DIR:-${LILITH_THUNDERBIRD_PROFILE_DIR:-}}
    if [ -n "$tb_override" ]; then
        if [ -d "$tb_override" ]; then
            printf '%s\n' "$tb_override"
        fi
        return 0
    fi
    [ -n "${HOME:-}" ] || return 0
    for tb_root in \
        "${XDG_CONFIG_HOME:-$HOME/.config}/thunderbird" \
        "$HOME/.thunderbird" \
        "$HOME/.var/app/org.mozilla.Thunderbird/.thunderbird" \
        "$HOME/snap/thunderbird/common/.thunderbird"
    do
        tb_found=$(firefox_from_ini "$tb_root")
        if [ -n "$tb_found" ]; then
            printf '%s\n' "$tb_found"
            return 0
        fi
    done
    return 0
}

install_thunderbird() {
    tb_src=$root/thunderbird
    if [ ! -d "$tb_src" ]; then
        echo "padilha-dots: missing $tb_src" >&2
        exit 1
    fi
    tb_profile=$(find_thunderbird_profile)
    if [ -z "$tb_profile" ]; then
        echo "padilha-dots: no Thunderbird profile yet; launch Thunderbird once, quit it, then run 'padilha-dots thunderbird'." >&2
        return 0
    fi
    tb_chrome=$tb_profile/chrome
    mkdir -p "$tb_chrome"

    tb_userjs=$tb_profile/user.js
    if [ -e "$tb_userjs" ] || [ -L "$tb_userjs" ]; then
        if [ -L "$tb_userjs" ]; then
            rm -f "$tb_userjs"
        elif ! cmp -s "$tb_src/user.js" "$tb_userjs"; then
            tb_backup=$tb_userjs.pre-padilha-$(date +%Y%m%d-%H%M%S)
            echo "padilha-dots: backing up $tb_userjs -> $tb_backup" >&2
            mv "$tb_userjs" "$tb_backup"
        fi
    fi
    cp "$tb_src/user.js" "$tb_userjs"
    printf '%s (copy)\n' "$tb_userjs"

    for tb_name in userChrome.css userContent.css; do
        tb_src_file=$tb_src/chrome/$tb_name
        tb_dst_file=$tb_chrome/$tb_name
        if [ ! -f "$tb_src_file" ]; then
            echo "padilha-dots: missing $tb_src_file" >&2
            exit 1
        fi
        if [ -e "$tb_dst_file" ] || [ -L "$tb_dst_file" ]; then
            tb_existing=$(readlink -f -- "$tb_dst_file" 2>/dev/null || true)
            tb_wanted=$(readlink -f -- "$tb_src_file" 2>/dev/null || true)
            if [ -n "$tb_existing" ] && [ "$tb_existing" = "$tb_wanted" ]; then
                :
            elif [ -L "$tb_dst_file" ]; then
                rm -f "$tb_dst_file"
            else
                tb_backup=$tb_dst_file.pre-padilha-$(date +%Y%m%d-%H%M%S)
                echo "padilha-dots: backing up $tb_dst_file -> $tb_backup" >&2
                mv "$tb_dst_file" "$tb_backup"
            fi
        fi
        ln -sfn "$tb_src_file" "$tb_dst_file"
        printf '%s -> %s\n' "$tb_dst_file" "$tb_src_file"
    done

    if [ ! -f "$tb_chrome/padilha.css" ]; then
        echo "padilha-dots: note: $tb_chrome/padilha.css is missing; run 'padilha-theme apply --wallpaper ...' to generate the palette." >&2
    fi
}

# --- Thunar, GTK and Flatpak ---------------------------------------------
install_gtk() {
    if [ "${gtk_done:-0}" -eq 1 ]; then
        return 0
    fi

    for gt_version in 3 4; do
        gt_src=$root/gtk-$gt_version.0/settings.ini
        gt_dir=$config/gtk-$gt_version.0
        gt_dst=$gt_dir/settings.ini
        if [ ! -f "$gt_src" ]; then
            echo "padilha-dots: missing $gt_src" >&2
            exit 1
        fi
        if [ -e "$gt_dir" ] && [ ! -d "$gt_dir" ]; then
            echo "padilha-dots: $gt_dir exists and is not a directory" >&2
            exit 1
        fi

        # Link one file only. gtk.css and thunar.css in this directory are
        # owned by padilha-theme; creating the directory must never replace
        # them.
        mkdir -p "$gt_dir"
        if [ -e "$gt_dst" ] && [ ! -L "$gt_dst" ]; then
            gt_backup=$gt_dst.pre-padilha-$(date +%Y%m%d-%H%M%S)
            echo "padilha-dots: backing up $gt_dst -> $gt_backup" >&2
            mv "$gt_dst" "$gt_backup"
        fi
        ln -sfn "$gt_src" "$gt_dst"
        printf '%s -> %s\n' "$gt_dst" "$gt_src"
    done

    gtk_done=1
}

install_flatpak() {
    fp_src=$root/flatpak/overrides/global
    fp_data=${XDG_DATA_HOME:-$HOME/.local/share}
    fp_dir=$fp_data/flatpak/overrides
    fp_dst=$fp_dir/global
    if [ ! -f "$fp_src" ]; then
        echo "padilha-dots: missing $fp_src" >&2
        exit 1
    fi
    if [ -e "$fp_dir" ] && [ ! -d "$fp_dir" ]; then
        echo "padilha-dots: $fp_dir exists and is not a directory" >&2
        exit 1
    fi

    mkdir -p "$fp_dir"
    if [ -e "$fp_dst" ] && [ ! -L "$fp_dst" ]; then
        fp_backup=$fp_dst.pre-padilha-$(date +%Y%m%d-%H%M%S)
        echo "padilha-dots: backing up $fp_dst -> $fp_backup" >&2
        mv "$fp_dst" "$fp_backup"
    fi
    ln -sfn "$fp_src" "$fp_dst"
    printf '%s -> %s\n' "$fp_dst" "$fp_src"
}

reset_flatpak() {
    fp_src=$root/flatpak/overrides/global
    fp_data=${XDG_DATA_HOME:-$HOME/.local/share}
    fp_dst=$fp_data/flatpak/overrides/global

    if [ -L "$fp_dst" ]; then
        fp_existing=$(readlink -f -- "$fp_dst" 2>/dev/null || true)
        fp_wanted=$(readlink -f -- "$fp_src" 2>/dev/null || true)
        if [ -n "$fp_existing" ] && [ "$fp_existing" = "$fp_wanted" ]; then
            rm -f "$fp_dst"
            printf '%s (removed)\n' "$fp_dst"
        else
            echo "padilha-dots: leaving $fp_dst; it is not managed by this checkout" >&2
        fi
    elif [ -e "$fp_dst" ]; then
        # Never delete a real user override or the backup made by the installer.
        echo "padilha-dots: leaving real Flatpak override $fp_dst unchanged" >&2
    else
        printf '%s (already absent)\n' "$fp_dst"
    fi
}

install_thunar() {
    th_src=$root/thunar
    th_dst=$config/Thunar
    if [ ! -d "$th_src" ]; then
        echo "padilha-dots: missing $th_src" >&2
        exit 1
    fi
    mkdir -p "$th_dst"
    for th_file in thunarrc uca.xml; do
        th_src_file=$th_src/$th_file
        th_dst_file=$th_dst/$th_file
        if [ ! -f "$th_src_file" ]; then
            echo "padilha-dots: missing $th_src_file" >&2
            exit 1
        fi
        if [ -e "$th_dst_file" ] && [ ! -L "$th_dst_file" ]; then
            th_backup=$th_dst_file.pre-padilha-$(date +%Y%m%d-%H%M%S)
            echo "padilha-dots: backing up $th_dst_file -> $th_backup" >&2
            mv "$th_dst_file" "$th_backup"
        fi
        ln -sfn "$th_src_file" "$th_dst_file"
        printf '%s -> %s\n' "$th_dst_file" "$th_src_file"
    done
    install_gtk
}

# -------------------------------------------------------------------------

for name in $names; do
    if [ "$name" = mc ]; then
        mc_src="$root/mc"
        mc_dst="$config/mc"
        if [ ! -d "$mc_src" ]; then
            echo "padilha-dots: missing $mc_src" >&2
            exit 1
        fi
        mkdir -p "$mc_dst"
        for file in ini mc.keymap mc.ext.ini menu mc-clipboard-files.sh; do
            src="$mc_src/$file"
            dst="$mc_dst/$file"
            if [ ! -f "$src" ]; then
                echo "padilha-dots: missing $src" >&2
                exit 1
            fi
            if [ "$file" = ini ]; then
                # MC writes its setup (including the [Panelize] order) back to
                # ini on exit. Keep it a real file so the repository does not
                # become dirty every time MC is used; only seed it once.
                if [ -L "$dst" ]; then
                    rm -f "$dst"
                elif [ -e "$dst" ]; then
                    printf '%s (keeping existing mutable MC ini)\n' "$dst"
                    continue
                fi
                cp -f "$src" "$dst"
                printf '%s (copy)\n' "$dst"
                continue
            fi
            if [ -e "$dst" ] && [ ! -L "$dst" ]; then
                echo "padilha-dots: refusing to replace real path $dst" >&2
                exit 1
            fi
            ln -sfn "$src" "$dst"
            printf '%s -> %s\n' "$dst" "$src"
        done
        continue
    fi

    if [ "$name" = thunderbird ]; then
        install_thunderbird
        continue
    fi

    if [ "$name" = firefox ]; then
        install_firefox
        continue
    fi

    if [ "$name" = lazygit ]; then
        src="$root/lazygit/config.yml"
        dst="$config/lazygit/config.yml"
        if [ ! -f "$src" ]; then
            echo "padilha-dots: missing $src" >&2
            exit 1
        fi
        mkdir -p "$config/lazygit"
        if [ -e "$dst" ] && [ ! -L "$dst" ]; then
            backup="$dst.pre-padilha-$(date +%Y%m%d-%H%M%S)"
            echo "padilha-dots: backing up $dst -> $backup" >&2
            mv "$dst" "$backup"
        fi
        ln -sfn "$src" "$dst"
        printf '%s -> %s\n' "$dst" "$src"
        continue
    fi

    if [ "$name" = dsh-tui ]; then
        src="$root/dsh-tui/themes"
        dst="${HOME}/.dsh-tui/themes"
        if [ ! -d "$src" ]; then
            echo "padilha-dots: missing $src" >&2
            exit 1
        fi
        if [ -e "$dst" ] && [ ! -L "$dst" ]; then
            backup="$dst.pre-padilha-$(date +%Y%m%d-%H%M%S)"
            echo "padilha-dots: backing up $dst -> $backup" >&2
            mv "$dst" "$backup"
        fi
        mkdir -p "${HOME}/.dsh-tui"
        ln -sfn "$src" "$dst"
        printf '%s -> %s\n' "$dst" "$src"
        # The runtime theme plugin is loaded from the profile's node_modules.
        profile="${DSH_HOME:-$HOME/.dsh}/profiles/dsh-tui"
        if [ -d "$root/dsh-tui/plugin" ]; then
            mkdir -p "$profile/node_modules"
            ln -sfn "$root/dsh-tui/plugin" "$profile/node_modules/padilha-theme-sync"
            printf '%s -> %s\n' "$profile/node_modules/padilha-theme-sync" "$root/dsh-tui/plugin"
        fi
        continue
    fi

    if [ "$name" = zsh ]; then
        src="$root/zsh"
        dst="$config/zsh"
        if [ ! -d "$src" ]; then
            echo "padilha-dots: missing $src" >&2
            exit 1
        fi
        if [ -e "$dst" ] && [ ! -L "$dst" ]; then
            backup="$dst.pre-padilha-$(date +%Y%m%d-%H%M%S)"
            echo "padilha-dots: backing up $dst -> $backup" >&2
            mv "$dst" "$backup"
        fi
        ln -sfn "$src" "$dst"
        printf '%s -> %s\n' "$dst" "$src"
        continue
    fi

    if [ "$name" = btop ]; then
        src="$root/btop/btop.conf"
        dst="$config/btop/btop.conf"
        if [ ! -f "$src" ]; then
            echo "padilha-dots: missing $src" >&2
            exit 1
        fi
        mkdir -p "$config/btop"
        if [ -e "$dst" ] && [ ! -L "$dst" ]; then
            backup="$dst.pre-padilha-$(date +%Y%m%d-%H%M%S)"
            echo "padilha-dots: backing up $dst -> $backup" >&2
            mv "$dst" "$backup"
        fi
        ln -sfn "$src" "$dst"
        printf '%s -> %s\n' "$dst" "$src"
        continue
    fi

    if [ "$name" = thunar ]; then
        install_thunar
        continue
    fi

    if [ "$name" = gtk ]; then
        install_gtk
        continue
    fi

    if [ "$name" = flatpak ]; then
        install_flatpak
        continue
    fi

    if [ "$name" = flatpak-reset ]; then
        reset_flatpak
        continue
    fi

    if [ "$name" = micro ]; then
        if [ ! -x "$root/micro/install.sh" ]; then
            echo "padilha-dots: missing $root/micro/install.sh" >&2
            exit 1
        fi
        "$root/micro/install.sh"
        continue
    fi

    src="$root/$name"
    dst="$config/$name"

    if [ ! -d "$src" ]; then
        echo "padilha-dots: missing $src" >&2
        exit 1
    fi

    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        echo "padilha-dots: refusing to replace real path $dst" >&2
        exit 1
    fi

    ln -sfn "$src" "$dst"
    printf '%s -> %s\n' "$dst" "$src"
done
